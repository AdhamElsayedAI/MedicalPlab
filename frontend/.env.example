# MedicalPlab Frontend Environment Variables
# ==============================================================================
# 1. LOCAL DEVELOPMENT (DEFAULT — ZERO SECRETS REQUIRED)
# ==============================================================================
# Point client directly to local MedicalPlab FastAPI backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RUNTIME_MODE=pilot

# Optional server-side proxy target (defaults to http://localhost:8000 if omitted):
# MEDICALPLAB_API_BASE_URL=http://localhost:8000

# In local development (NODE_ENV !== 'production'), mentor access code is optional.
# Set MENTOR_ACCESS_CODE only if testing the mentor gate locally:
# MENTOR_ACCESS_CODE=optional-local-mentor-code

# ==============================================================================
# 2. OPTIONAL CLOUD STAGING (RENDER / VERCEL - SERVER-ONLY SECRETS)
# ==============================================================================
# When deploying to Vercel pointing to remote Render staging:
# MEDICALPLAB_STAGING_BASE_URL=https://medicalplab-staging.onrender.com
# STAGING_ACCESS_KEY=your-staging-access-key-here
# MENTOR_ACCESS_CODE=your-mentor-access-code-here
# MENTOR_SESSION_SECRET=your-mentor-session-secret-here
