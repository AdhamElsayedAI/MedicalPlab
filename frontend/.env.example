# MedicalPlab Frontend Environment Variables

# Google Cloud Run Production Endpoint (Set in Vercel Project Settings)
# Replace with your Cloud Run service URL generated after deployment:
NEXT_PUBLIC_API_URL=https://medicalplab-api-xxxxxxx-uc.a.run.app

# Hugging Face Spaces Production Endpoint (Zero-card alternative):
# NEXT_PUBLIC_API_URL=https://<your-hf-username>-medicalplab-api.hf.space

# Local Development Endpoint (uvicorn main:app --host 0.0.0.0 --port 8000):
# NEXT_PUBLIC_API_URL=http://localhost:8000
