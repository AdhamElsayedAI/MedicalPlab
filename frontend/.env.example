# MedicalPlab Frontend Environment Variables

# ==============================================================================
# VERCEL SERVER-SIDE STAGING CONFIGURATION (SERVER-ONLY - NEVER USE NEXT_PUBLIC_)
# ==============================================================================
# Render Free Web Service staging URL:
MEDICALPLAB_STAGING_BASE_URL=https://medicalplab-staging.onrender.com

# Shared closed-staging access key injected server-side by Next.js proxy (/api/medicalplab/*):
STAGING_ACCESS_KEY=your-staging-access-key-here

# Mentor browser access gate code (entered by mentor to initiate session):
MENTOR_ACCESS_CODE=your-mentor-access-code-here

# Optional secret for signing mentor session cookies (auto-generated if omitted):
MENTOR_SESSION_SECRET=your-mentor-session-secret-here

# Backwards-compatibility aliases:
# BFF_BASE_URL=https://medicalplab-staging.onrender.com
# MEDICALPLAB_BFF_URL=https://medicalplab-staging.onrender.com

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (PUBLIC)
# ==============================================================================
# In staging/mentor mode, Next.js routes API calls through the same-origin proxy
# at /api/medicalplab/* so no public API URL is needed.
# For direct standalone browser-to-backend mode (e.g. local demo):
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_RUNTIME_MODE=demo
