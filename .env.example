# MedicalPlab Environment Configuration Template
# Safe default placeholders for local demo and evaluation.
# DO NOT COMMIT REAL CREDENTIALS OR LIVE PRODUCTION SECRETS.

# Runtime Mode: 'demo', 'test', 'pilot', or 'production'
MEDICALPLAB_RUNTIME_MODE=demo

# Base directory for datasets, metadata manifests, and question versions
MEDICALPLAB_DATA_ROOT=./Data

# Preview QA Mode: Set to true to inspect candidate review queues in demo mode; false for strict golden-only serving
MEDICALPLAB_PLAB_PREVIEW_QA=false

# Allowed CORS origins for FastAPI backend (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clinician Review API Token (Used for /api/v1/review endpoints; min 32 chars in pilot/production)
MEDICALPLAB_INTERNAL_REVIEW_TOKEN=demo-insecure-local-development-token-32chars-min

# Backend Server Port
PORT=8000
