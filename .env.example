# MedicalPlab Environment Configuration Template
# ==============================================================================
# AUTHORITATIVE LOCAL-FIRST RUNTIME CONFIGURATION (ZERO SECRETS REQUIRED)
# ==============================================================================
# All defaults below are safe, zero-cost, and immediately runnable on any machine.
# Copy this file to .env or export these variables in your shell.

# 1. Runtime Mode: 'pilot' activates the fail-closed clinical engine
MEDICALPLAB_RUNTIME_MODE=pilot

# 2. Base directory for datasets, manifests, and question versions (default: ./Data)
MEDICALPLAB_DATA_ROOT=./Data

# 3. PLAB Preview QA Governance (1 = enables 36 candidate questions for review)
MEDICALPLAB_PLAB_PREVIEW_QA=1

# 4. Feature Flags: Socratic Remediation & 3D Anatomy Lab
MEDICALPLAB_PHASE_2B_ENABLED=1
MEDICALPLAB_ANATOMY_3D_ENABLED=1

# 5. Tutor Provider: 'stub' provides deterministic zero-cost responses (no paid API key needed)
MEDICALPLAB_TUTOR_PROVIDER=stub

# 6. Local Staging Gate: Disabled for normal local usage (no X-Staging-Key needed)
MEDICALPLAB_STAGING_GATE_ENABLED=0

# 7. Allowed CORS origins for local frontend (Next.js runs on :3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 8. Server Port
PORT=8000

# ==============================================================================
# OPTIONAL ADVANCED CONFIGURATION (OPTIONAL / NOT REQUIRED FOR LOCAL RUN)
# ==============================================================================
# Staging closed-access key (only used when MEDICALPLAB_STAGING_GATE_ENABLED=1):
# STAGING_ACCESS_KEY=your-staging-key-here

# Optional external LLM API keys (only if switching away from stub Tutor):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
