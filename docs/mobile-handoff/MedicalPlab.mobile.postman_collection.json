    {
      "name": "University",
      "item": [
        {
          "name": "Get Subjects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/university/subjects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "university",
                "subjects"
              ]
            }
          }
        },
        {
          "name": "Get Topics by Subject",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/university/topics?subject=Renal%20physiology",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "university",
                "topics"
              ],
              "query": [
                {
                  "key": "subject",
                  "value": "Renal physiology"
                }
              ]
            }
          }
        },
        {
          "name": "Get Next Question (No Answer Leak)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/university/question?subject=Renal%20physiology&topic=RAAS%20mechanisms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "university",
                "question"
              ],
              "query": [
                {
                  "key": "subject",
                  "value": "Renal physiology"
                },
                {
                  "key": "topic",
                  "value": "RAAS mechanisms"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Answer (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{question_id}}\",\n  \"selected_option\": \"B\",\n  \"idempotency_key\": \"{{idempotency_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/university/answer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "university",
                "answer"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a fresh UUID v4 for idempotency_key to prevent double-scoring on retries",
                  "function uuidv4() {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        var r = Math.random() * 16 | 0;",
                  "        var v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "}",
                  "pm.variables.set('idempotency_key', uuidv4());",
                  "console.log('Generated idempotency_key:', pm.variables.get('idempotency_key'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get University Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/university/progress",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "university",
                "progress"
              ]
            }
          }
        }
      ]
    },
    {
