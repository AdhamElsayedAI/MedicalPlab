  "components": {
    "schemas": {
      "AnatomyCommandRequest": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "focus",
                  "highlight",
                  "isolate",
                  "ghost",
                  "reset",
                  "show",
                  "hide"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "structure_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Structure Ids"
          },
          "opacity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.05
              },
              {
                "type": "null"
              }
            ],
            "title": "Opacity"
          }
        },
        "type": "object",
        "title": "AnatomyCommandRequest"
      },
      "ClinicalReasonRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Query"
          },
          "case_context": {
