{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedicalPlab Qwen4B Domain Adaptation Evaluation Report",
  "type": "object",
  "required": ["benchmark", "n_queries", "product_dev_v3_sha256", "base_model", "base_revision", "adapter_sha256", "train_sha256", "before", "after", "performance", "gate"],
  "properties": {
    "benchmark": {"const": "PRODUCT_DEV_V3"},
    "n_queries": {"const": 100},
    "product_dev_v3_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_model": {"const": "Qwen/Qwen3-Embedding-4B"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "train_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate": {"type": "object", "required": ["status", "passed", "thresholds"]}
  }
}
