{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalplab.local/schemas/retrieval_eval.schema.json",
  "title": "MedicalPlab Retrieval Evaluation Set",
  "type": "object",
  "required": [
    "eval_set_id",
    "version",
    "cases"
  ],
  "properties": {
    "eval_set_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy/default document ID used when a relevant block does not declare document_id."
    },
    "corpus_document_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional explicit list of documents forming the evaluation corpus."
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_id",
          "query",
          "language",
          "query_type",
          "difficulty",
          "expected_answerable",
          "target_concept",
          "expected_parent_section_number",
          "relevant_blocks"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 3
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "mixed"
            ]
          },
          "query_type": {
            "type": "string",
            "enum": [
              "direct_fact",
              "paraphrase",
              "clinical_style",
              "acronym_heavy",
              "cross_lingual",
              "unsupported"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "expected_answerable": {
            "type": "boolean"
          },
          "target_concept": {
            "type": "string",
            "minLength": 1
          },
          "expected_parent_section_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "relevant_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "block_index",
                "relevance",
                "rationale"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "relevance": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}