{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicalplab://schemas/evidence_verifier_output_v1.schema.json",
  "title": "MedicalPlab Evidence Verifier Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "claims",
    "source_constraint_satisfied",
    "verdict_rationale"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "status",
          "evidence_refs",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^DOC-[A-Z0-9-]+:B[0-9]{4}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "supported"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "source_constraint_satisfied": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "verdict_rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "supported"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "properties": {
                "status": {
                  "const": "supported"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "unsupported"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "properties": {
                "status": {
                  "const": "unsupported"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "partial"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "supported"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unsupported"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              }
            ]
          }
        }
      }
    }
  ]
}
