{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalplab.local/schemas/retrieval_eval_v2.schema.json",
  "title": "MedicalPlab Retrieval Evaluation Set v2",
  "type": "object",
  "required": [
    "eval_set_id",
    "version",
    "corpus_document_ids",
    "description",
    "cases"
  ],
  "properties": {
    "eval_set_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy/default document ID. Optional in v2; document-aware gold labels should declare document_id explicitly."
    },
    "corpus_document_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_id",
          "query",
          "language",
          "query_type",
          "difficulty",
          "expected_answerable",
          "target_concept",
          "expected_parent_section_number",
          "evidence_scope",
          "target_document_ids",
          "preferred_document_id",
          "relevant_blocks",
          "notes"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 3
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ar",
              "mixed"
            ]
          },
          "query_type": {
            "type": "string",
            "enum": [
              "direct_fact",
              "paraphrase",
              "clinical_style",
              "acronym_heavy",
              "cross_lingual",
              "unsupported",
              "source_selection",
              "multi_source"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "expected_answerable": {
            "type": "boolean"
          },
          "target_concept": {
            "type": "string",
            "minLength": 1
          },
          "expected_parent_section_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_scope": {
            "type": "string",
            "enum": [
              "single_source",
              "multi_source",
              "authority_sensitive",
              "unsupported"
            ]
          },
          "target_document_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferred_document_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "relevant_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "block_index",
                "relevance",
                "rationale"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "relevance": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "const": "unsupported"
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "expected_answerable": {
                  "const": false
                },
                "target_document_ids": {
                  "maxItems": 0
                },
                "preferred_document_id": {
                  "type": "null"
                },
                "relevant_blocks": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "const": "single_source"
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "expected_answerable": {
                  "const": true
                },
                "target_document_ids": {
                  "minItems": 1,
                  "maxItems": 1
                },
                "preferred_document_id": {
                  "type": "null"
                },
                "relevant_blocks": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "const": "multi_source"
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "expected_answerable": {
                  "const": true
                },
                "target_document_ids": {
                  "minItems": 2
                },
                "preferred_document_id": {
                  "type": "null"
                },
                "relevant_blocks": {
                  "minItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_scope": {
                  "const": "authority_sensitive"
                }
              },
              "required": [
                "evidence_scope"
              ]
            },
            "then": {
              "properties": {
                "expected_answerable": {
                  "const": true
                },
                "target_document_ids": {
                  "minItems": 1
                },
                "preferred_document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relevant_blocks": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
