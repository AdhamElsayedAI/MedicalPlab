{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalplab.local/schemas/chunk.schema.json",
  "title": "MedicalPlab Retrieval Chunk",
  "description": "Canonical retrieval chunk used by the MedicalPlab RAG pipeline.",
  "type": "object",
  "required": [
    "chunk_id",
    "document_id",
    "source_id",
    "medical_specialty",
    "topics",
    "source_block_index",
    "block_type",
    "section_path",
    "start_page",
    "end_page",
    "chunk_index",
    "chunk_count_in_block",
    "text",
    "character_count",
    "content_sha256"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "medical_specialty": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_block_index": {
      "type": "integer",
      "minimum": 1
    },
    "source_block_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "numbered_section",
        "recommendation",
        "implementation_remarks",
        "evidence_rationale",
        "evidence_to_decision",
        "abstract",
        "paragraph",
        "table_caption",
        "table_row",
        "table_note",
        "figure_caption"
      ]
    },
    "section_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "section_level": {
      "type": "integer",
      "minimum": 0
    },
    "parent_section_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_section_heading": {
      "type": [
        "string",
        "null"
      ]
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "heading": {
      "type": "string"
    },
    "start_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "end_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_count_in_block": {
      "type": "integer",
      "minimum": 1
    },
    "is_split": {
      "type": "boolean"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "character_count": {
      "type": "integer",
      "minimum": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "provenance_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "page",
        "xml_element",
        null
      ],
      "description": "How the chunk is located in the canonical source artifact."
    },
    "source_locator": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Source-specific locator. Examples: page range or stable normalized JATS block identifier."
    },
    "source_format": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pdf",
        "pmc_jats_xml",
        null
      ],
      "description": "Canonical ingestion source format."
    },
    "retrieval_section_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional semantic hierarchy used for retrieval. Source-faithful section_path remains unchanged."
    }
  },
  "additionalProperties": false
}
