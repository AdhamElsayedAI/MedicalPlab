{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedicalPlab Medical Source",
  "description": "Governed source metadata used by the MedicalPlab AI data pipeline.",
  "type": "object",

  "required": [
    "source_id",
    "title",
    "provider",
    "source_type",
    "medical_domains",
    "use_cases",
    "trust_tier",
    "license_status",
    "ai_use_status",
    "ingestion_status"
  ],

  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "provider": {
      "type": "string",
      "minLength": 1
    },

    "source_type": {
      "type": "string",
      "enum": [
        "guideline",
        "government_health",
        "journal_article",
        "systematic_review",
        "dataset",
        "textbook",
        "question_bank",
        "other"
      ]
    },

    "medical_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "rag",
          "question_generation",
          "evaluation"
        ]
      },
      "uniqueItems": true
    },

    "trust_tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },

    "publication_year": {
      "type": [
        "integer",
        "null"
      ]
    },

    "url": {
      "type": [
        "string",
        "null"
      ]
    },

    "license_name": {
      "type": [
        "string",
        "null"
      ]
    },

    "license_status": {
      "type": "string",
      "enum": [
        "approved",
        "conditional",
        "pending_review",
        "blocked"
      ]
    },

    "ai_use_status": {
      "type": "string",
      "enum": [
        "allowed",
        "allowed_with_conditions",
        "permission_required",
        "blocked",
        "unclear"
      ]
    },

    "commercial_use": {
      "type": [
        "boolean",
        "null"
      ]
    },

    "freshness_policy": {
      "type": "string",
      "enum": [
        "latest_available",
        "last_5_years",
        "static_benchmark",
        "manual_review"
      ]
    },

    "ingestion_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "processing",
        "processed",
        "blocked",
        "failed"
      ]
    },

    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },

  "additionalProperties": false
}