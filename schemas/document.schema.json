{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedicalPlab Medical Document",
  "description": "Canonical metadata schema for documents admitted to the MedicalPlab knowledge pipeline.",
  "type": "object",

  "required": [
    "document_id",
    "source_id",
    "title",
    "medical_specialty",
    "topics",
    "document_type",
    "evidence_level",
    "publication_date",
    "url",
    "license_status",
    "rag_allowed",
    "question_generation_allowed",
    "ingestion_status"
  ],

  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },

    "source_id": {
      "type": "string",
      "minLength": 1
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "medical_specialty": {
      "type": "string",
      "minLength": 1
    },

    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "document_type": {
      "type": "string",
      "enum": [
        "clinical_guideline",
        "systematic_review",
        "meta_analysis",
        "review_article",
        "government_guidance",
        "educational_reference",
        "other"
      ]
    },

    "evidence_level": {
      "type": "string",
      "enum": [
        "high",
        "moderate",
        "supporting"
      ]
    },

    "publication_date": {
      "type": [
        "string",
        "null"
      ]
    },

    "version": {
      "type": [
        "string",
        "null"
      ]
    },

    "url": {
      "type": [
       "string",
       "null"
      ]
    },

    "doi": {
      "type": [
        "string",
        "null"
      ]
    },

    "license_name": {
      "type": [
        "string",
        "null"
      ]
    },

    "license_status": {
      "type": "string",
      "enum": [
        "approved",
        "conditional",
        "pending_review",
        "blocked"
      ]
    },

    "rag_allowed": {
      "type": "boolean"
    },

    "question_generation_allowed": {
      "type": "boolean"
    },

    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },

    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },

    "ingestion_status": {
      "type": "string",
      "enum": [
        "candidate",
        "approved",
        "downloaded",
        "processed",
        "rejected",
        "blocked",
        "failed"
      ]
    },

    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },

  "additionalProperties": false
}